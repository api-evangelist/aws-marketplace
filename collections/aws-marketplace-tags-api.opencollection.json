{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS Marketplace Catalog Change Sets Tags API",
    "version": "2018-09-17"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Tag a resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://catalog.marketplace.{region}.amazonaws.com/TagResource",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Tag a resource"
        },
        {
          "info": {
            "name": "Untag a resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://catalog.marketplace.{region}.amazonaws.com/UntagResource",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Untag a resource"
        },
        {
          "info": {
            "name": "List tags for a resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://catalog.marketplace.{region}.amazonaws.com/ListTagsForResource",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "List tags for a resource"
        }
      ]
    }
  ],
  "bundled": true
}